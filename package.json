{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "sewage-backend",
    "version": "1.0.0",
    "type": "commonjs",
    "main": "dist/index.js",
    "scripts": {
        "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
        "build": "prisma generate && npx tsc",
        "start": "node dist/index.js",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev",
        "prisma:studio": "prisma studio",
        "seed:admin": "ts-node src/seedAdmin.ts",
        "seed:lookups": "ts-node src/seed.ts",
        "postinstall": "prisma generate"
    },
    "dependencies": {
        "@prisma/client": "^6.19.3",
        "@prisma/adapter-pg": "^6.19.3",
        "@types/nodemailer": "^7.0.11",
        "bcrypt": "^6.0.0",
        "bcryptjs": "^2.4.3",
        "cors": "^2.8.6",
        "dotenv": "^16.6.1",
        "esbuild": "^0.28.0",
        "express": "^4.22.1",
        "jsonwebtoken": "^9.0.3",
        "nodemailer": "^6.10.1",
        "pg": "^8.18.0"
    },
    "devDependencies": {
        "@types/bcrypt": "^6.0.0",
        "@types/bcryptjs": "^2.4.6",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.25",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^20.19.39",
        "@types/pg": "^8.16.0",
        "prisma": "^6.19.3",
        "ts-node": "^10.9.2",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.9.3"
    }
}