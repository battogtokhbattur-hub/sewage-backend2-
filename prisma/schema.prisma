generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  DRIVER  // ⚠️ Хэрэглэхгүй (хуучин системийн үлдэгдэл) — жолооч одоо Driver хүснэгт ашигладаг
}

enum PriceType {
  FIXED
  PERCENT
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  password     String
  name         String?           // Овог нэр
  phone        String?           // Утасны дугаар
  companyName  String?           // Байгууллагын нэр (хэрэв хувь хүн биш бол)
  address      String?           // Үндсэн хаяг (preset)
  role         Role     @default(USER)
  orders       Order[]
  savedOrders  SavedOrderTemplate[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Driver {
  id           Int      @id @default(autoincrement())
  name         String                    // Жолоочийн нэр
  phone        String                    // Утасны дугаар
  truckName    String?                   // Машин нэр (марк/загвар) - "Hyundai HD78"
  truckPlate   String?                   // Машины улсын дугаар - "УБА-1234"
  truckCapacity Float?  @default(0)      // Багтаамж (тонн)
  isActive     Boolean  @default(true)   // Идэвхтэй / устгагдсан эсэх
  notes        String?                   // Нэмэлт тэмдэглэл
  orders       Order[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Хэрэглэгчийн хадгалсан "тогтмол захиалгын загвар"
// Жишээ: "Гэрийн хаяг — 2 тонн — Бохир ус" гэх мэт
model SavedOrderTemplate {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  label         String              // "Гэр", "Ажил", "Сууц 1" гэх мэт танигч
  serviceTypeId Int?
  zoneId        Int?
  address       String
  volume        Float
  volumeUnit    String   @default("TON")
  pitStatus     String?             // "yes" / "no"
  pitType       String?             // "septic", etc.
  notes         String?
  lat           Float?
  lng           Float?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ServiceType {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  orders    Order[]
  createdAt DateTime @default(now())
}

model Zone {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  basePrice   Int      @default(0)
  perTonPrice Int      @default(0)
  perM3Price  Int      @default(0)
  perKmPrice  Int      @default(0)
  orders      Order[]
  createdAt   DateTime @default(now())
}

model AddOnService {
  id          Int          @id @default(autoincrement())
  code        String       @unique
  name        String
  priceType   PriceType    @default(FIXED)
  priceValue  Int          @default(0)
  isActive    Boolean      @default(true)
  orderAddOns OrderAddOn[]
  createdAt   DateTime     @default(now())
}

model TimeSlot {
  id          Int      @id @default(autoincrement())
  date        DateTime
  startTime   String
  endTime     String
  capacity    Int      @default(3)
  bookedCount Int      @default(0)
  orders      Order[]
  createdAt   DateTime @default(now())

  @@index([date])
  @@unique([date, startTime, endTime])
}

model Order {
  id            Int      @id @default(autoincrement())

  userId        Int
  user          User     @relation(fields: [userId], references: [id])

  // ── Жолооч ──
  driverId      Int?
  driver        Driver?  @relation(fields: [driverId], references: [id])
  assignedAt    DateTime?  // Жолоочид хувиарлагдсан огноо

  // ── Төлбөр ──
  paid          Boolean  @default(false)
  paidAt        DateTime?  // Төлбөр төлөгдсөн огноо
  paymentMethod String?    // "BANK_TRANSFER" | "CASH"

  date          String?
  customerName  String?
  customerPhone String?
  notes         String?

  // Wizard-аас ирэх энгийн field-үүд
  serviceCode   String   @default("BOHIR_US")
  district      String   @default("БЗД")
  unit          String   @default("тонн")
  timeSlot      String   @default("09-11")
  extras        String[]
  totalPrice    Int      @default(0)

  // ── Нүхний мэдээлэл — ШИНЭЭР НЭМСЭН ──
  pitStatus     String?  // "yes" | "no" | "unsure"
  pitType       String?  // "septic" | "pitToilet" | "tank"

  // Одоогийн field-үүд
  address       String
  volume        Float    @default(0)
  volumeUnit    String   @default("TON")
  lat           Float?
  lng           Float?
  status        String   @default("PENDING")
  priceSubtotal Int      @default(0)
  priceTotal    Int      @default(0)

  // Relations
  serviceTypeId Int?
  serviceType   ServiceType? @relation(fields: [serviceTypeId], references: [id])

  zoneId        Int?
  zone          Zone?        @relation(fields: [zoneId], references: [id])

  slotId        Int?
  slot          TimeSlot?    @relation(fields: [slotId], references: [id])

  addOns        OrderAddOn[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model OrderAddOn {
  orderId Int
  addOnId Int

  order Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  addOn AddOnService @relation(fields: [addOnId], references: [id], onDelete: Cascade)

  @@id([orderId, addOnId])
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
}
